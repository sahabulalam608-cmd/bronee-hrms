{
  "name": "bronee-hrms",
  "private": true,
  "version": "1.0.0",
  "description": "BRONEE HRMS — employee and workforce management platform for BRONEE Limited",
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "preview": "npm --workspace web run preview",
    "typecheck": "npm --workspace web run typecheck && npm --workspace worker run typecheck",
    "worker:dev": "npm --workspace worker run dev",
    "worker:deploy": "npm --workspace worker run deploy",
    "db:migrate": "npm --workspace worker run db:migrate",
    "test": "python3 tests/run_all.py"
  }
}
