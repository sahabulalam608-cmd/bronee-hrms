{
  "name": "@bronee/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply bronee_hrms --remote",
    "db:migrate:local": "wrangler d1 migrations apply bronee_hrms --local",
    "db:seed": "wrangler d1 execute bronee_hrms --remote --file ./scripts/seed.sql",
    "db:seed:local": "wrangler d1 execute bronee_hrms --local --file ./scripts/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bronee/shared": "*",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
